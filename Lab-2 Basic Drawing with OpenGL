#include <GL/glut.h>
#include <cmath>

void drawCircle(float cx, float cy, float r)
{
    glBegin(GL_LINE_LOOP);

    for (int i = 0; i < 360; i++)
    {
        float angle = i * 3.14159 / 180;

        float x = cx + r * cos(angle);
        float y = cy + r * sin(angle);

        glVertex2f(x, y);
    }

    glEnd();
}

void display()
{
    glClear(GL_COLOR_BUFFER_BIT);

    // Point
    glPointSize(8);
    glBegin(GL_POINTS);
        glVertex2f(-0.5, 0.5);
    glEnd();

    // Line
    glBegin(GL_LINES);
        glVertex2f(-0.7, 0.0);
        glVertex2f(0.7, 0.0);
    glEnd();

    // Circle
    drawCircle(0.0, -0.4, 0.25);

    glFlush();
}

int main(int argc, char** argv)
{
    glutInit(&argc, argv);
    glutInitDisplayMode(GLUT_SINGLE | GLUT_RGB);
    glutInitWindowSize(600, 600);
    glutCreateWindow("Lab 2 - Basic Shapes");

    glClearColor(0, 0, 0, 1);

    glutDisplayFunc(display);
    glutMainLoop();

    return 0;
}
